# MXReady 环境变量模板
# 复制为 .env 后按需修改；应用直接读取进程环境变量，
# Docker 部署时可用 `docker compose --env-file .env up` 注入。
# 所有未设置项使用内置默认值，详见 backend/mxready/config.py。

# 数据目录（SQLite 数据库所在目录）
# MXREADY_DATA_DIR=data

# 规则目录（YAML 规则集，ruleset v1）
# MXREADY_RULES_DIR=rules/v1

# 扫描临时目录（克隆仓库用）
# MXREADY_TEMP_DIR=data/tmp

# 前端构建产物目录（index.html 所在目录）
# MXREADY_FRONTEND_DIR=frontend/dist

# 日志级别：DEBUG / INFO / WARNING / ERROR
# MXREADY_LOG_LEVEL=INFO

# 托管平台白名单（逗号分隔，保持安全默认值；仅内部部署时扩展）
# MXREADY_ALLOWED_HOSTS=github.com,gitee.com

# 自定义规则扩展目录（可选，合并其中的规则集）
# MXREADY_EXTRA_RULES_DIR=

# 数据保留：超过 N 天未更新的扫描记录在启动时清理（0 = 不清理，默认关闭）
# MXREADY_SCAN_RETENTION_DAYS=0

# 防护（默认关闭限流，公网部署时开启）
# MXREADY_RATE_LIMIT_ENABLED=false
# MXREADY_RATE_LIMIT_PER_MINUTE=20
# MXREADY_MAX_CONCURRENT_SCANS=2
# MXREADY_MAX_REQUEST_BYTES=1048576
