diff --git a/tests/L0/run_build_utils/test_build_utils.py b/tests/L0/run_build_utils/test_build_utils.py
new file mode 100644
index 0000000..245c6d3
--- /dev/null
+++ b/tests/L0/run_build_utils/test_build_utils.py
@@ -0,0 +1,33 @@
+import os
+import sys
+import unittest
+from pathlib import Path
+
+REPOSITORY_ROOT = Path(__file__).resolve().parents[3]
+sys.path.insert(0, str(REPOSITORY_ROOT))
+
+from apex_build_utils import resolve_cuda_compiler
+
+
+class BuildUtilsTest(unittest.TestCase):
+    def test_uses_cuda_home_nvcc_by_default(self):
+        compiler = resolve_cuda_compiler("/opt/cuda", {})
+
+        self.assertEqual(compiler, os.path.join("/opt/cuda", "bin", "nvcc"))
+
+    def test_uses_explicit_apex_nvcc_override(self):
+        compiler = resolve_cuda_compiler(
+            "/opt/cuda",
+            {"APEX_NVCC": "/opt/maca/bin/compatible-compiler"},
+        )
+
+        self.assertEqual(compiler, "/opt/maca/bin/compatible-compiler")
+
+    def test_empty_override_keeps_default(self):
+        compiler = resolve_cuda_compiler("/opt/cuda", {"APEX_NVCC": ""})
+
+        self.assertEqual(compiler, os.path.join("/opt/cuda", "bin", "nvcc"))
+
+
+if __name__ == "__main__":
+    unittest.main()
