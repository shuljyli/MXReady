@@ -0,0 +1,7 @@
+import os
+
+
+def resolve_cuda_compiler(cuda_dir, environment=None):
+    """Return the compiler used for CUDA toolkit version detection."""
+    environment = os.environ if environment is None else environment
+    return environment.get("APEX_NVCC") or os.path.join(cuda_dir, "bin", "nvcc")
